{
  "name": "hiredue-outreach",
  "private": true,
  "version": "0.1.0",
  "description": "LinkedIn outreach workflows built as a node graph, run on your own logged-in accounts",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "vite build && OUTREACH_DIST=1 electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.8.0",
    "better-sqlite3": "^12.2.0",
    "camoufox-js": "0.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.53.0",
    "playwright": "^1.59.1",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.14.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "electron": "^37.10.3",
    "electron-rebuild": "^3.2.9",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  }
}
